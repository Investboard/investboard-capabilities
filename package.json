{
	"name": "investboard-capabilities",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"build": "pnpm -r build",
		"typecheck": "pnpm -r typecheck",
		"test": "vitest run",
		"example": "pnpm build && node packages/stress-test/examples/replay.mjs && node packages/rebalancing/examples/compare.mjs && node packages/performance/examples/replay.mjs && node packages/goal-planning/examples/schedule.mjs && node packages/instrument-research/examples/research.mjs && node packages/portfolio-intelligence/examples/look-through.mjs",
		"example:rebalancing": "pnpm --filter @investboard/rebalancing build && node packages/rebalancing/examples/compare.mjs",
		"example:performance": "pnpm --filter @investboard/performance build && node packages/performance/examples/replay.mjs",
		"example:goals": "pnpm --filter @investboard/goal-planning build && node packages/goal-planning/examples/schedule.mjs",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"example:research": "pnpm --filter @investboard/instrument-research build && node packages/instrument-research/examples/research.mjs",
		"example:intelligence": "pnpm --filter @investboard/portfolio-intelligence build && node packages/portfolio-intelligence/examples/look-through.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.13",
		"@types/node": "20.19.39",
		"typescript": "5.9.3",
		"vitest": "4.1.9",
		"zod": "4.6.7"
	},
	"engines": {
		"node": ">=22"
	},
	"packageManager": "pnpm@9.15.0"
}
